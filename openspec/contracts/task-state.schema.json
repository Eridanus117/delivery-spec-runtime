{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeSlug",
    "revision",
    "updatedAt",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "changeSlug": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "title",
          "status",
          "dependsOn",
          "deliverable",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "implemented_unverified",
              "blocked_external",
              "verified"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliverable": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "blocker": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "required": [
                "evidence"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "blocked_external"
                }
              }
            },
            "then": {
              "required": [
                "blocker"
              ]
            }
          }
        ]
      }
    }
  }
}
