{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-change/task-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "deliverables", "verification", "evidence", "blocker"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "enum": ["planned", "implemented_unverified", "blocked_external", "verified"] },
          "deliverables": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence": {
            "type": "array",
            "description": "证据是 Change 内的相对路径，写入时由 delivery-control 校验其存在且内容非空；绝对路径与 .. 越界一律拒绝且不写入任何状态。该校验只作用于 active Change 的写入路径，不回溯归档目录中的自然语言证据。",
            "items": { "type": "string", "minLength": 1, "pattern": "^(?!/|[A-Za-z]:)(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$" }
          },
          "blocker": { "type": ["string", "null"] }
        },
        "allOf": [
          { "if": { "properties": { "state": { "const": "verified" } } }, "then": { "properties": { "evidence": { "minItems": 1 }, "blocker": { "type": "null" } } }, "else": { "properties": { "evidence": { "maxItems": 0 } } } },
          { "if": { "properties": { "state": { "const": "blocked_external" } } }, "then": { "properties": { "blocker": { "type": "string", "minLength": 1 } } }, "else": { "properties": { "blocker": { "type": "null" } } } }
        ]
      }
    }
  }
}
