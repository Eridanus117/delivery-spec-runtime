{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Sources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeSlug",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "changeSlug": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "location",
          "observedAt",
          "completeness"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completeness": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
