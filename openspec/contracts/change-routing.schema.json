{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-change/change-routing.schema.json",
  "title": "Change routing table",
  "description": "按改动对象把 Intake 条目路由到交付档位，并声明该类改动是否必须先走分析线。本表是立项门与档位选择的唯一真源：调用方不得自述豁免，也不得为绕过门禁失败而降档；未匹配的改动对象一律取最重档且不豁免。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routingVersion", "unmatched", "routes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "routingVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "unmatched": {
      "description": "改动对象未在 routes 中命中时的兜底判定。必须是最重档且不豁免。",
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "requiresAnalysis", "reason"],
      "properties": {
        "profileId": { "const": "delivery-change" },
        "requiresAnalysis": { "const": true },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["changeObject", "displayName", "description", "profileId", "requiresAnalysis", "reason"],
        "properties": {
          "changeObject": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "profileId": { "enum": ["delivery-change", "light-change"] },
          "requiresAnalysis": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
