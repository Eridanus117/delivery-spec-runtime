{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-change/change-routing.schema.json",
  "title": "Change routing table",
  "description": "按改动对象把 Intake 条目路由到交付档位，并声明该类改动是否必须先走分析线。本表是立项门的唯一真源，其中被机器强制的部分是：requiresAnalysis（是否必须有分析线产物）、analysisProfileId（产物须由哪个 profile 产出）、promotable（该改动对象是否允许立项）、rank + pathPrefixes（guard verify 用来核对声明与实际触碰路径是否相符）。profileId 记录该改动对象对应的交付档位，由 promote 写入条目 History 留痕；调用方不得自述豁免，也不得为绕过门禁失败而降档；未匹配的改动对象一律取最重档且不豁免。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routingVersion", "unmatched", "routes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "routingVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "unmatched": {
      "description": "改动对象未在 routes 中命中、或实际触碰路径不属于任何已声明前缀时的兜底判定。必须是最重档且不豁免，rank 必须严格大于任何 route 的 rank。",
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "requiresAnalysis", "analysisProfileId", "rank", "reason"],
      "properties": {
        "profileId": { "const": "delivery-change" },
        "requiresAnalysis": { "const": true },
        "analysisProfileId": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["changeObject", "displayName", "description", "profileId", "requiresAnalysis", "rank", "pathPrefixes", "reason"],
        "properties": {
          "changeObject": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "profileId": { "enum": ["delivery-change", "light-change"] },
          "requiresAnalysis": { "type": "boolean" },
          "analysisProfileId": { "type": "string", "minLength": 1, "description": "必走分析线时必填：立项门要求分析线产物的 workflow-binding.profileId 必须等于该值，避免随便绑一个 profile 跑出来的 result 也算数。" },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "description": "档位序。数值越大代表改动对象越重。声明低 rank 而实际触碰高 rank 路径时，guard verify fail-closed。"
          },
          "pathPrefixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 },
            "description": "该改动对象的仓库内路径前缀。guard verify 用它把实际 git diff 触碰的路径归类，与登记时声明的 changeObject 对照。"
          },
          "promotable": {
            "type": "boolean",
            "description": "该改动对象是否允许 promote 立项。缺省为 true；声明为 false 表示其定义与「产生 Change」自相矛盾，intake promote 必须直接拒绝。"
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
