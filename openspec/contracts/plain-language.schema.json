{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-change/plain-language.schema.json",
  "title": "Plain language policy",
  "description": "说人话关的配置：哪些文字必须先交给一个没有本仓上下文的读者审读、哪些明确豁免、以及一份不许再出现的词的名单。被机器强制的部分是：mustPass（Change 内必过路径，缺审读记录即拒绝）、repoMustPass（仓内必过路径，供禁词扫描）、bannedWords（命中即拒绝）。manualMustPass 与 exempt 不参与机器判定，它们记录的是「为什么这一类不由机器管」，缺了这个说明，后来人会把「机器没查」误读成「不用过」。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "note", "mustPass", "repoMustPass", "manualMustPass", "exempt", "bannedWords", "bannedWordsPolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "note": { "type": "string", "minLength": 1 },
    "mustPass": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "changePathPatterns", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "changePathPatterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 },
            "description": "相对 Change 根的路径样式，支持 * 与 **。"
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "repoMustPass": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "repoPathPatterns", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "repoPathPatterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "manualMustPass": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exempt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bannedWords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["word", "replacement", "reason", "addedAt"],
        "properties": {
          "word": { "type": "string", "minLength": 1 },
          "replacement": { "type": "string", "minLength": 1, "description": "必须给出替代词：没有替代词的禁令会让人不知道该怎么写。" },
          "reason": { "type": "string", "minLength": 1 },
          "addedAt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bannedWordsPolicy": { "type": "string", "minLength": 1 }
  }
}
