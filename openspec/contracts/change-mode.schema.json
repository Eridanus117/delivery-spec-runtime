{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit Rehearsal Mode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "reason",
    "approvedBy",
    "approvedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "rehearsal"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
