{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-change/workflow-profile.schema.json",
  "title": "Workflow profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "profileVersion", "displayName", "purpose", "recommendedFor", "notRecommendedFor", "handoff", "stages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "profileVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "displayName": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "recommendedFor": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "notRecommendedFor": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "handoff": { "type": "string", "minLength": 1 },
    "inputContracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "enum": ["string", "object", "array", "enum"] },
          "requiredFields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "itemRequiredFields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "minItems": { "type": "integer", "minimum": 1 },
          "enum": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "description", "exitCondition", "requiredInputs", "humanJudgment"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "exitCondition": { "type": "string", "minLength": 1 },
          "requiredInputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "humanJudgment": { "type": "boolean" },
          "judgmentOptions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "repeatOnJudgments": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "outputInputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
