{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivery-spec-runtime.local/contracts/acceptance-state.schema.json",
  "title": "Acceptance State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "implementationCommit", "reviewDigest", "acceptanceDigest", "acceptedBy", "acceptedAt", "result"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "implementationCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewDigest": { "$ref": "#/$defs/sha256" },
    "acceptanceDigest": { "$ref": "#/$defs/sha256" },
    "acceptedBy": { "type": "string", "minLength": 1 },
    "acceptedAt": { "type": "string", "format": "date-time" },
    "result": { "enum": ["PASS", "FAIL"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
