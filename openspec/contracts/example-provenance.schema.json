{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Example Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "example", "sourceCategory", "reviewConclusion", "reviewedAt", "reviewedBy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "example": {"type": "string", "minLength": 1},
    "sourceCategory": {"enum": ["synthetic", "approved-desensitized"]},
    "reviewConclusion": {"const": "approved-for-public-candidate"},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "reviewedBy": {"type": "string", "minLength": 1}
  }
}
