{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eridanus117/delivery-spec-runtime/contracts/openspec-upgrade-report.schema.json",
  "title": "OpenSpec upgrade evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "currentVersion", "candidateVersion", "runtimeBaselineCommit", "startedAt", "endedAt", "generations", "deltas", "probes", "blankFixture", "consumers", "realRepositoriesUnchanged", "temporaryRootsCleaned", "result"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "currentVersion": { "type": "string" },
    "candidateVersion": { "type": "string" },
    "runtimeBaselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "generations": { "$ref": "#/$defs/generations" },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "currentLocal", "candidateLocal"],
      "properties": {
        "upstream": { "$ref": "#/$defs/delta" },
        "currentLocal": { "$ref": "#/$defs/delta" },
        "candidateLocal": { "$ref": "#/$defs/delta" }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "candidate"],
      "properties": {
        "current": { "type": "array", "items": { "$ref": "#/$defs/probe" } },
        "candidate": { "type": "array", "items": { "$ref": "#/$defs/probe" } }
      }
    },
    "blankFixture": { "$ref": "#/$defs/check" },
    "consumers": { "type": "array", "items": { "$ref": "#/$defs/consumer" } },
    "realRepositoriesUnchanged": { "type": "boolean" },
    "temporaryRootsCleaned": { "type": "boolean" },
    "result": { "enum": ["PASS", "FAIL"] }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^opsx-[a-z0-9-]+\\.md$" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedVersion", "actualVersion", "commands"],
      "properties": {
        "requestedVersion": { "type": "string" },
        "actualVersion": { "type": "string" },
        "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "generations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "candidate"],
      "properties": {
        "current": { "$ref": "#/$defs/generation" },
        "candidate": { "$ref": "#/$defs/generation" }
      }
    },
    "deltaEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "changeType", "beforeSha256", "afterSha256", "additions", "deletions"],
      "properties": {
        "path": { "type": "string" },
        "changeType": { "enum": ["added", "removed", "modified", "unchanged"] },
        "beforeSha256": { "type": ["string", "null"] },
        "afterSha256": { "type": ["string", "null"] },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "files"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/deltaEntry" } }
      }
    },
    "probeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": { "type": "string" },
        "type": { "enum": ["array", "boolean", "null", "number", "object", "string"] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "status", "fields", "structureSha256", "result"],
      "properties": {
        "id": { "type": "string" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "integer" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/probeField" } },
        "structureSha256": { "type": ["string", "null"] },
        "result": { "enum": ["PASS", "FAIL", "SKIP"] }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "result"],
      "properties": {
        "status": { "type": "integer" },
        "result": { "enum": ["PASS", "FAIL"] }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "description": "消费仓冒烟条目随时间演进，两种形状都合法：2026-09-01 之前产出的报告没有 failureReason 键，本仓已归档的证据即属此列且明文不回溯改写；此后产出的报告一律携带该键。故 failureReason 不进 required——把它设为必填，等于让本仓公开分发的机器合同拒绝本仓自己的归档证据。但只要该键出现，取值约束就是硬的：FAIL 必须带非空原因，PASS 必须为 null，否则「有字段」就能过合同而字段可以永远是 null。新报告必须携带该键这件事由产出侧保证并有断言守住，不靠合同的 required 兜底（与 artifact-approvals 合同同时容纳 v5/v6 两种工件集是同一范式）。",
      "required": ["name", "head", "beforeDigest", "afterDigest", "runtimeStatus", "probeStatus", "result"],
      "properties": {
        "name": { "type": "string" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "beforeDigest": { "type": "string" },
        "afterDigest": { "type": "string" },
        "runtimeStatus": { "type": "integer" },
        "probeStatus": { "type": "integer" },
        "failureReason": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "冒烟失败的原因文本，按行截断。存量归档条目无此键。"
        },
        "result": { "enum": ["PASS", "FAIL"] }
      },
      "allOf": [
        {
          "if": { "required": ["failureReason"], "properties": { "result": { "const": "FAIL" } } },
          "then": { "properties": { "failureReason": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "required": ["failureReason"], "properties": { "result": { "const": "PASS" } } },
          "then": { "properties": { "failureReason": { "type": "null" } } }
        }
      ]
    }
  }
}
